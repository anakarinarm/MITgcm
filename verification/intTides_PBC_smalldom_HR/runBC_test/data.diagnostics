# Minimal boundary-reflection output. Keep 3-D and 2-D fields in separate
# streams: otherwise MITgcm selects their single common level.
 &DIAGNOSTICS_LIST
  dumpAtLast=.FALSE.,

  fields(1:3,1)='UVEL    ','VVEL    ','PHIHYD  ',
  fileName(1)='bc_wave_3d',
  frequency(1)=-11178.,
  timePhase(1)=0.,
  fileFlags(1)='R       ',

  fields(1,2)='ETAN    ',
  fileName(2)='bc_wave_eta',
  frequency(2)=-11178.,
  timePhase(2)=0.,
  fileFlags(2)='R       ',
 &

 &DIAG_STATIS_PARMS
 &
