# HR analytical south-entering M2 boundary test.
# South receives a tapered normal velocity with A0=0.01 m/s; north receives a
# uniform compensating return flow; west prescribed velocity is zero. No SSH.
 &OBCS_PARM01
 OB_Iwest = 720*1,
 OB_Jsouth = 660*1,
 OB_Jnorth = 660*720,
 useOBCSbalance=.FALSE.,
 useOBCSprescribe=.TRUE.,
 useOBCSsponge=.TRUE.,
 OBCSsponge_W=.TRUE.,
 OBCSsponge_S=.TRUE.,
 OBCSsponge_N=.TRUE.,
 OBCSsponge_E=.FALSE.,
 OBCSsponge_UatNS=.TRUE.,
 OBCSsponge_UatEW=.TRUE.,
 OBCSsponge_VatNS=.TRUE.,
 OBCSsponge_VatEW=.TRUE.,
 OBCSsponge_Theta=.FALSE.,
 OBCSsponge_Salt=.FALSE.,
 useLinearSponge=.FALSE.,
 OBCS_monitorFreq=1200.,
 OBCSprintDiags=.FALSE.,
 useStevensWest=.TRUE.,
 useStevensSouth=.TRUE.,
 useStevensNorth=.TRUE.,
 useOBCStides = .TRUE.,
 OBCS_tidalperiod = 44712.,
 OBS_vTidAmFile = '../input/OBSvam_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBN_vTidAmFile = '../input/OBNvam_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBW_uTidAmFile = '../input/OBWuam_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBS_vTidPhFile = '../input/OBSvph_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBN_vTidPhFile = '../input/OBNvph_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBW_uTidPhFile = '../input/OBWuph_M2_analyticSouth_A001_Nreturn_HR660x720_telescopic60.bin',
 OBNtFile = '../input/linTN_telescopic60.bin',
 OBStFile = '../input/linTS_telescopic60.bin',
 OBWtFile = '../input/linTW_telescopic60.bin',
 OBNsFile = '../input/linSN_telescopic60.bin',
 OBSsFile = '../input/linSS_telescopic60.bin',
 OBWsFile = '../input/linSW_telescopic60.bin',
 &

# Strong momentum-only sponge over the complete 60-cell telescopic buffer,
# matching the preferred LR analytical boundary-test family.
 &OBCS_PARM03
 spongeThickness=60,
 Urelaxobcsbound=1397.25,
 Urelaxobcsinner=44712.,
 Vrelaxobcsbound=1397.25,
 Vrelaxobcsinner=44712.,
 &

# During inflow, relax T/S toward the prescribed background profiles.
# During outflow, Stevens radiates tracer anomalies out of the domain.
 &OBCS_PARM04
 TrelaxStevens=3600.,
 SrelaxStevens=3600.,
 useStevensPhaseVel=.TRUE.,
 useStevensAdvection=.TRUE.,
 &
