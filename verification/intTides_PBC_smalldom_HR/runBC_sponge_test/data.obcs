# Open-boundaries
 &OBCS_PARM01
 OB_Iwest = 600*1,
 OB_Jsouth = 600*1,
 OB_Jnorth = 600*600,
 useOBCSbalance=.FALSE.,
 useOBCSprescribe=.TRUE.,
 useOBCSsponge=.TRUE.,
 OBCSsponge_W=.TRUE.,
 OBCSsponge_S=.TRUE.,
 OBCSsponge_N=.TRUE.,
 OBCSsponge_E=.FALSE.,
 OBCSsponge_UatNS=.TRUE.,
 OBCSsponge_UatEW=.TRUE.,
 OBCSsponge_VatNS=.TRUE.,
 OBCSsponge_VatEW=.TRUE.,
 OBCSsponge_Theta=.FALSE.,
 OBCSsponge_Salt=.FALSE.,
 useLinearSponge=.FALSE.,
 OBCS_monitorFreq=1200.,
 OBCSprintDiags=.FALSE.,
 useStevensWest=.TRUE.,
 useStevensSouth=.TRUE.,
 useStevensNorth=.TRUE.,
 useOBCStides = .TRUE.,
 OBCS_tidalperiod = 44712.,
 OBS_vTidAmFile = '../input/OBSvam_M2_zeroNet.bin',
 OBN_vTidAmFile = '../input/OBNvam_M2_zeroNet.bin',
 OBW_uTidAmFile = '../input/OBWuam_M2_zeroNet.bin',
 OBS_vTidPhFile = '../input/OBSvph_M2_zeroNet.bin',
 OBN_vTidPhFile = '../input/OBNvph_M2_zeroNet.bin',
 OBW_uTidPhFile = '../input/OBWuph_M2_zeroNet.bin',
 OBNtFile = '../input/linTN.bin',
 OBStFile = '../input/linTS.bin',
 OBWtFile = '../input/linTW.bin',
 OBNsFile = '../input/linSN.bin',
 OBSsFile = '../input/linSS.bin',
 OBWsFile = '../input/linSW.bin',
 &

# Weak, smoothly tapered 30-cell momentum absorbing layer: M2/4 at the
# boundary, increasing to 2*M2 at the inner edge. With ~180-m cells this
# layer is about 5--6 km wide. Tracer sponge switches above remain off.
 &OBCS_PARM03
 spongeThickness=30,
 Urelaxobcsbound=11178.,
 Urelaxobcsinner=89424.,
 Vrelaxobcsbound=11178.,
 Vrelaxobcsinner=89424.,
 &

# During inflow, relax T/S toward the prescribed background profiles.
# During outflow, Stevens radiates tracer anomalies out of the domain.
 &OBCS_PARM04
 TrelaxStevens=3600.,
 SrelaxStevens=3600.,
 useStevensPhaseVel=.TRUE.,
 useStevensAdvection=.TRUE.,
 &
