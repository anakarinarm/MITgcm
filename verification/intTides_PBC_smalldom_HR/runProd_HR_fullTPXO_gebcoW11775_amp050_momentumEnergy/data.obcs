# Open-boundaries
# HR full-TPXO GEBCO W117.75 amplitude sensitivity: same accepted production
# configuration, but TPXO M2 SSH and velocity amplitudes are multiplied by 0.5
# on the W/S/N open boundaries.
 &OBCS_PARM01
 OB_Iwest = 720*1,
 OB_Jsouth = 750*1,
 OB_Jnorth = 750*720,
 useOBCSbalance=.FALSE.,
 useOBCSprescribe=.TRUE.,
 useOBCSsponge=.TRUE.,
 OBCSsponge_W=.TRUE.,
 OBCSsponge_S=.TRUE.,
 OBCSsponge_N=.TRUE.,
 OBCSsponge_E=.FALSE.,
 OBCSsponge_UatNS=.TRUE.,
 OBCSsponge_UatEW=.TRUE.,
 OBCSsponge_VatNS=.TRUE.,
 OBCSsponge_VatEW=.TRUE.,
 OBCSsponge_Theta=.FALSE.,
 OBCSsponge_Salt=.FALSE.,
 useLinearSponge=.FALSE.,
 OBCS_monitorFreq=1200.,
 OBCSprintDiags=.FALSE.,
 useStevensWest=.FALSE.,
 useStevensSouth=.FALSE.,
 useStevensNorth=.FALSE.,
 useOBCStides = .FALSE.,
 OBWetaFile = '../input/OBWeta_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBSetaFile = '../input/OBSeta_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBNetaFile = '../input/OBNeta_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBWuFile = '../input/OBWu_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBWvFile = '../input/OBWv_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBSuFile = '../input/OBSu_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBSvFile = '../input/OBSv_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBNuFile = '../input/OBNu_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBNvFile = '../input/OBNv_M2_fullTPXO_HR750x720_gebcoW11775_physW11775_tel60_obeta16_amp050.bin',
 OBNtFile = '../input/linTN_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 OBStFile = '../input/linTS_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 OBWtFile = '../input/linTW_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 OBNsFile = '../input/linSN_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 OBSsFile = '../input/linSS_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 OBWsFile = '../input/linSW_telescopic60_HR750x720_gebcoW11775_physW11775_tel60_obeta16.bin',
 &

# Momentum-only sponge over the complete 60-cell HR telescopic buffer. The
# effective relaxation vanishes smoothly at the inner edge because the
# nonlinear sponge target blends into the local model velocity there.
 &OBCS_PARM03
 spongeThickness=60,
 Urelaxobcsbound=1397.25,
 Urelaxobcsinner=89424.,
 Vrelaxobcsbound=1397.25,
 Vrelaxobcsinner=89424.,
 &

# Stevens is disabled in this nonlinear-free-surface SSH-clamped test because
# the present MITgcm/OBCS implementation does not support Stevens + NLFS.
 &OBCS_PARM04
 TrelaxStevens=3600.,
 SrelaxStevens=3600.,
 useStevensPhaseVel=.FALSE.,
 useStevensAdvection=.FALSE.,
 &
